# Copy this file to `.env` and fill in values. `.env` is git-ignored and must never be committed.

# Where the pipeline runs: "local" (MinIO in Docker) or "aws" (real S3)
SMOGWATCH_ENV=local

# S3 bucket name
SMOGWATCH_BUCKET=smogwatch-pk-local

# Local MinIO only (leave empty for AWS)
SMOGWATCH_S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=ap-south-1

# Prefect (local server by default; Prefect Cloud URL/key in production)
PREFECT_API_URL=http://localhost:4200/api
